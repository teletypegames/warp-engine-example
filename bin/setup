#!/bin/sh
# Brings up the whole example stack: the catalog with its admin, then the git
# server and the CI, which the engine starts and wires itself (WarpEngine local
# components, through the Docker socket). Run it again any time: what is already
# set up is left alone.
#
#   bin/setup            catalog + git server + CI
#   bin/setup --no-ci    catalog and admin only
set -eu

cd "$(dirname "$0")/.."

WITH_CI=1
[ "${1:-}" = "--no-ci" ] && WITH_CI=0

[ -f .env ] || cp .env.example .env

get() { sed -n "s/^$1=//p" .env | tail -n 1; }
or_default() { value=$(get "$1"); [ -n "$value" ] && printf '%s' "$value" || printf '%s' "$2"; }
wait_for() {
  printf '  waiting for %s ' "$1"
  tries=0
  until curl -fs -o /dev/null "$2"; do
    tries=$((tries + 1))
    [ "$tries" -gt 120 ] && { echo " gave up"; exit 1; }
    printf '.'; sleep 5
  done
  echo " ok"
}
rails() { docker compose exec -T app bin/rails "$@"; }

APP_PORT=$(or_default APP_PORT 8080)
GITEA_PORT=$(or_default GITEA_PORT 3000)
WOODPECKER_PORT=$(or_default WOODPECKER_PORT 8000)

echo "1. The catalog"
docker compose up -d --build mysql app shelf-http shelf-ftp
wait_for "the catalog" "http://localhost:$APP_PORT/api/service"

if [ "$WITH_CI" = 0 ]; then
  echo
  echo "Done: http://localhost:$APP_PORT/admin (admin@example.org / warpengine)"
  exit 0
fi

echo "2. The git server and the CI, started and wired by the engine"
rails "warp_engine:local:enable[woodpecker]"

credentials=$(rails "warp_engine:local:credentials[gitea]")
GITEA_USER=$(printf '%s\n' "$credentials" | sed -n 's/^USER=//p')
GITEA_PASSWORD=$(printf '%s\n' "$credentials" | sed -n 's/^PASSWORD=//p')

if git config --get credential.helper >/dev/null 2>&1; then
  printf 'protocol=http\nhost=localhost:%s\nusername=%s\npassword=%s\n\n' \
    "$GITEA_PORT" "$GITEA_USER" "$GITEA_PASSWORD" | git credential approve
  GIT_NOTE="git already knows the gitea password (credential helper)."
else
  GIT_NOTE="git asks for the gitea user and password on the first push."
fi

cat <<EOF

Your studio is up.

  Catalog admin   http://localhost:$APP_PORT/admin       admin@example.org / warpengine
  Catalog API     http://localhost:$APP_PORT/api/software
  Gitea           http://localhost:$GITEA_PORT      $GITEA_USER / $GITEA_PASSWORD
  Woodpecker CI   http://localhost:$WOODPECKER_PORT      (sign in through Gitea)
  Shelves         $(or_default SHELF_HTTP_URL http://localhost:8090) (HTTP, WARP64U)   $(or_default SHELF_FTP_URL ftp://localhost:2121) (FTP, DOSINST)

Next: install the WarpEngine Toolbox in VS Code, run "WarpEngine: Set Host…"
with http://localhost:$APP_PORT, then "WarpEngine: Sign In" and "New Game".
$GIT_NOTE

The git server and the CI are the engine's containers, not compose services:
  docker compose exec app bin/rails warp_engine:local:status
  docker compose exec -e PURGE=1 app bin/rails "warp_engine:local:remove[gitea]"   (before docker compose down -v)
EOF
